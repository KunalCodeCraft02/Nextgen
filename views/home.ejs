            <div class="timeline">
                <div class="timeline-spine"></div>

                <div class="timeline-item fade-in">
                    <div class="timeline-node">1</div>
                    <div class="timeline-content">
                        <div class="timeline-phase">Phase 1 · Event 1</div>
                        <div class="timeline-name"><i class="ri-anchor-line"></i> Genesis Bootcamp</div>
