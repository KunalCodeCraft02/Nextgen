                        <div class="timeline-tags"><span class="tag">Career Guidance</span><span class="tag">Higher
                                Studies</span><span class="tag">Stream Selection</span></div>
                    </div>
                </div>

                <div class="timeline-item fade-in">
                    <div class="timeline-node">7</div>
                    <div class="timeline-content">
