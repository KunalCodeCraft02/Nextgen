    <script>
        /* ── TOONHUB CAROUSEL ──────────────────────── */
        const IMAGES = [{ src: "/characters/1.png", bg: "#F4845F" }, { src: "/characters/2.png", bg: "#6BBF7A" }, { src: "/characters/3.png", bg: "#E882B4" }, { src: "/characters/4.png", bg: "#6EB5FF" }];
        IMAGES.forEach(x => { const i = new Image(); i.src = x.src });
        let activeIndex = 0, animating = false;
        const heroEl = document.getElementById("hero"), carouselEl = document.getElementById("carousel"), rootEl = document.documentElement;
        function hexToRgb(hex) { const clean = hex.replace("#", ""); const bigint = parseInt(clean, 16); return `${(bigint >> 16) & 255}, ${(bigint >> 8) & 255}, ${bigint & 255}` }
        function setThemeColor(hex) { rootEl.style.setProperty("--hero-accent", hex); rootEl.style.setProperty("--hero-accent-rgb", hexToRgb(hex)) }
        function isMobile() { return window.innerWidth < 640 }
        function render() {
            carouselEl.innerHTML = "";
            const center = activeIndex, left = (activeIndex + 3) % 4, right = (activeIndex + 1) % 4;
            IMAGES.forEach((item, idx) => {
                let role = "back";
                if (idx === center) role = "center"; else if (idx === left) role = "left"; else if (idx === right) role = "right";
                const div = document.createElement("div"); div.className = "card";
                const m = isMobile(); let s = {};
                if (role === "center") { s = { left: "50%", bottom: m ? "22%" : "0", height: m ? "60%" : "92%", transform: `translateX(-50%) scale(${m ? 1.25 : 1.68})`, filter: "blur(0px)", opacity: 1, zIndex: 20 } }
                else if (role === "left") { s = { left: m ? "20%" : "30%", bottom: m ? "32%" : "12%", height: m ? "16%" : "28%", transform: "translateX(-50%) scale(1)", filter: "blur(2px)", opacity: .85, zIndex: 10 } }
                else if (role === "right") { s = { left: m ? "80%" : "70%", bottom: m ? "32%" : "12%", height: m ? "16%" : "28%", transform: "translateX(-50%) scale(1)", filter: "blur(2px)", opacity: .85, zIndex: 10 } }
                else { s = { left: "50%", bottom: m ? "32%" : "12%", height: m ? "13%" : "22%", transform: "translateX(-50%) scale(1)", filter: "blur(4px)", opacity: 1, zIndex: 5 } }
                Object.assign(div.style, s);
                div.innerHTML = `<img src="${item.src}" draggable="false" alt="">`;
                carouselEl.appendChild(div);
            });
            heroEl.style.backgroundColor = IMAGES[activeIndex].bg;
            setThemeColor(IMAGES[activeIndex].bg);
        }
        function navigateNext() { if (animating) return; animating = true; activeIndex = (activeIndex + 1) % 4; render(); setTimeout(() => animating = false, 650) }
        function navigatePrev() { if (animating) return; animating = true; activeIndex = (activeIndex + 3) % 4; render(); setTimeout(() => animating = false, 650) }
        window.addEventListener("resize", () => { render(); if (window.innerWidth > 900) toggleMobile(false) });
        render();

        /* ── PARTICLES ─────────────────────────────── */
        const canvas = document.getElementById('particles'), ctx = canvas.getContext('2d');
        const COLORS = ['#F4845F', '#6BBF7A', '#E882B4', '#6EB5FF'];
        function resizeCanvas() { canvas.width = innerWidth; canvas.height = innerHeight }
        resizeCanvas(); window.addEventListener('resize', resizeCanvas);
        class Particle { constructor() { this.reset() } reset() { this.x = Math.random() * canvas.width; this.y = Math.random() * canvas.height; this.size = Math.random() * 1.5 + .3; this.vx = (Math.random() - .5) * .3; this.vy = (Math.random() - .5) * .3; this.opacity = Math.random() * .35 + .08; this.color = COLORS[Math.floor(Math.random() * COLORS.length)] } update() { this.x += this.vx; this.y += this.vy; if (this.x < 0 || this.x > canvas.width || this.y < 0 || this.y > canvas.height) this.reset() } draw() { ctx.beginPath(); ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2); ctx.fillStyle = this.color; ctx.globalAlpha = this.opacity; ctx.fill() } }
        const particles = Array.from({ length: 140 }, () => new Particle());
        (function loop() { ctx.clearRect(0, 0, canvas.width, canvas.height); ctx.globalAlpha = 1; particles.forEach(p => { p.update(); p.draw() }); requestAnimationFrame(loop) })();

        /* ── JS-READY + SCROLL ANIMATIONS ─────────── */
        document.body.classList.add('js-ready');
        const observer = new IntersectionObserver(entries => { entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); observer.unobserve(e.target) } }) }, { threshold: 0, rootMargin: '0px' });
        document.querySelectorAll('.fade-in,.fade-in-left,.fade-in-right').forEach(el => observer.observe(el));

        /* ── COUNT UP ──────────────────────────────── */
        function countUp(el) { const target = parseInt(el.dataset.target); const start = performance.now(); const dur = 1500; (function tick(now) { const t = Math.min((now - start) / dur, 1); const e = 1 - Math.pow(1 - t, 3); el.textContent = Math.round(e * target); if (t < 1) requestAnimationFrame(tick); else el.textContent = target + '+' })(start) }
        const statsObserver = new IntersectionObserver(entries => { entries.forEach(e => { if (e.isIntersecting) { e.target.querySelectorAll('[data-target]').forEach(countUp); statsObserver.unobserve(e.target) } }) }, { threshold: .3 });
        statsObserver.observe(document.getElementById('stats'));

        /* ── NAVBAR SCROLL ─────────────────────────── */
        window.addEventListener('scroll', () => { document.getElementById('navbar').classList.toggle('scrolled', scrollY > 60) });

        /* ── MOBILE MENU ───────────────────────────── */
        const mobileMenu = document.getElementById('mobileMenu'), hamburgerBtn = document.getElementById('hamburgerBtn');
        function toggleMobile(force) { const open = typeof force === 'boolean' ? force : !mobileMenu.classList.contains('open'); mobileMenu.classList.toggle('open', open); hamburgerBtn.classList.toggle('active', open); hamburgerBtn.setAttribute('aria-expanded', open ? 'true' : 'false'); document.body.classList.toggle('menu-open', open) }
        document.addEventListener('keydown', e => { if (e.key === 'Escape') toggleMobile(false) });

        /* ── SMOOTH SCROLL ─────────────────────────── */
        document.querySelectorAll('a[href^="#"]').forEach(a => { a.addEventListener('click', e => { const t = document.querySelector(a.getAttribute('href')); if (t) { e.preventDefault(); toggleMobile(false); t.scrollIntoView({ behavior: 'smooth', block: 'start' }) } }) });

        /* ── FAQ TOGGLE ────────────────────────────── */
        function toggleFaq(questionEl) {
            const item = questionEl.closest('.faq-item');
            const isOpen = item.classList.contains('open');
            document.querySelectorAll('.faq-item.open').forEach(i => i.classList.remove('open'));
            if (!isOpen) item.classList.add('open');
        }
    </script>
