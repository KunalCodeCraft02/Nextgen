    <div class="ornament-divider section-inner"><span class="ornament-icon">✦</span></div>

    <!-- INCENTIVES -->
    <section id="incentives">
        <div class="section-inner">
            <div class="section-header fade-in">
                <div class="eyebrow">The Rewards</div>
                <h2 class="section-title">Incentives</h2>
                <p class="section-desc">From cash prizes to campus workshops — here's what awaits every participant who
                    brings their A-game.</p>
            </div>
            <div class="incentives-grid">
                <div class="incentive-card fade-in">
                    <div class="incentive-card-icon"><i class="ri-money-dollar-circle-line"></i></div>
                    <h3>Cash Prizes</h3>
                    <p>The top-performing teams will receive cash prizes based on their overall performance in the
                        competition. Your hard work deserves real reward.</p>
                </div>
                <div class="incentive-card fade-in" style="transition-delay:.1s">
                    <div class="incentive-card-icon"><i class="ri-gift-line"></i></div>
                    <h3>Exclusive Rewards</h3>
                    <p>Top-performing students will be awarded premium gift hampers filled with exclusive E-Cell
                        merchandise and tech goodies to celebrate their innovation.</p>
                </div>
                <div class="incentive-card fade-in" style="transition-delay:.2s">
                    <div class="incentive-card-icon"><i class="ri-medal-line"></i></div>
                    <h3>Certification</h3>
                    <p>Receive prestigious certificates from E-Cell GCOEK, recognizing your successful completion of the
                        NextGen Innovators program.</p>
                </div>
                <div class="incentive-card fade-in" style="transition-delay:.3s">
                    <div class="incentive-card-icon"><i class="ri-user-star-line"></i></div>
                    <h3>Teacher Incentives</h3>
                    <p>Educators are the backbone of this initiative. Teachers get an exclusive free pass to our highly
                        requested "AI for Educators" workshop.</p>
                </div>
                <div class="incentive-card wide fade-in" style="transition-delay:.4s">
                    <div class="incentive-card-icon"><i class="ri-school-line"></i></div>
                    <h3>Campus Workshops</h3>
                    <p>Participating schools get the unique opportunity to host our "Startup 101" training sessions and
                        "Idea Ignite" presentation competitions directly on their own campus — building an internal
                        entrepreneurial ecosystem from the ground up.</p>
                </div>
            </div>
        </div>
    </section>

    <div class="ornament-divider section-inner"><span class="ornament-icon">✦</span></div>

    <!-- RULES & GUIDELINES -->
    <section id="rules">
        <div class="section-inner">
            <div class="section-header fade-in">
                <div class="eyebrow" style="color:var(--blue)">The Code of Conduct</div>
                <h2 class="section-title">Rules &amp; Guidelines</h2>
                <p class="section-desc">A fair and structured framework to ensure every school competes on an equal
                    footing.</p>
            </div>
            <div class="rules-list">
                <div class="rule-item fade-in">
                    <div class="rule-icon"><i class="ri-group-line"></i></div>
                    <div class="rule-body">
                        <h4>Team Limitation</h4>
                        <p>Each participating school may register a team with a maximum of 10 students to participate in
                            and represent the school throughout the NextGen Innovators initiative.</p>
                    </div>
                </div>
                <div class="rule-item fade-in">
                    <div class="rule-icon"><i class="ri-user-settings-line"></i></div>
                    <div class="rule-body">
                        <h4>Representatives</h4>
                        <p>Every school must nominate at least 1 teacher (faculty co-ordinator) who will serve as the
                            mentor and primary point of contact throughout the program.</p>
                    </div>
                </div>
                <div class="rule-item fade-in">
                    <div class="rule-icon"><i class="ri-file-text-line"></i></div>
                    <div class="rule-body">
                        <h4>Task Submission Guidelines</h4>
                        <p>All assigned tasks must be submitted in the prescribed format provided by E-Cell GCOEK and
                            follow the specified submission guidelines without exception.</p>
                    </div>
                </div>
                <div class="rule-item fade-in">
                    <div class="rule-icon"><i class="ri-award-line"></i></div>
                    <div class="rule-body">
                        <h4>Certification Eligibility</h4>
                        <p>Certificates will be awarded only to the students and schools that successfully establish an
                            E-Cell on their campus and complete all required tasks.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <div class="ornament-divider section-inner"><span class="ornament-icon">✦</span></div>

